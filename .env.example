# Solana RPC — Helius recommended (public RPC will rate-limit and break the demo)
# Get a free key at https://dashboard.helius.dev
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Optional: demo wallet to show in read-only mode when no wallet is connected
# NEXT_PUBLIC_DEMO_WALLET=
